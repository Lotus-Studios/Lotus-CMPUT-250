# Auto detect text files and perform LF normalization
* text=auto

[merge "unityyamlmerge"]
    name = Unity YAML Merge
    driver = "C:\Program Files\Unity\Hub\Editor\2022.3.62f3\Editor\Data\Tools\UnityYAMLMerge.exe" merge -p "%O" "%A" "%B" "%P"
    recursive = binary

# Unity SmartMerge (UnityYAMLMerge) Configuration
*.unity merge=unityyamlmerge
*.prefab merge=unityyamlmerge
*.asset merge=unityyamlmerge

# Force common Unity text files to always use LF line endings
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.asmdef text eol=lf
